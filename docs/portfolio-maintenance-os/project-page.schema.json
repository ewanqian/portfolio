{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ewanqian.site/schemas/project-page.schema.json",
  "title": "Ewan Qian Portfolio Project Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "status",
    "section",
    "projectType",
    "authorship",
    "title",
    "year",
    "summary",
    "description",
    "role",
    "media",
    "credits"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["published", "archive", "private"] },
    "section": { "enum": ["gallery", "production", "research", "archive"] },
    "projectType": {
      "enum": [
        "artwork",
        "live-audiovisual",
        "installation",
        "collaboration",
        "production-case",
        "research",
        "workshop"
      ]
    },
    "authorship": { "enum": ["personal", "collaborative", "commissioned", "production-support"] },
    "title": { "$ref": "#/$defs/localizedText" },
    "subtitle": { "$ref": "#/$defs/localizedText" },
    "year": { "type": "string", "minLength": 4 },
    "dateStart": { "type": "string" },
    "dateEnd": { "type": "string" },
    "city": { "$ref": "#/$defs/localizedText" },
    "venue": { "$ref": "#/$defs/localizedText" },
    "format": { "$ref": "#/$defs/localizedText" },
    "durationOrDimensions": { "$ref": "#/$defs/localizedText" },
    "summary": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "spatialAudiovisualLogic": { "$ref": "#/$defs/localizedText" },
    "role": { "$ref": "#/$defs/localizedText" },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "gallery"],
      "properties": {
        "hero": { "$ref": "#/$defs/mediaItem" },
        "gallery": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/mediaItem" }
        },
        "video": { "type": "array", "items": { "$ref": "#/$defs/linkItem" } }
      }
    },
    "credits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name"],
        "properties": {
          "role": { "$ref": "#/$defs/localizedText" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "presentationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "venue"],
        "properties": {
          "year": { "type": "string" },
          "venue": { "$ref": "#/$defs/localizedText" },
          "city": { "$ref": "#/$defs/localizedText" },
          "note": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "links": { "type": "array", "items": { "$ref": "#/$defs/linkItem" } },
    "relatedProjectIds": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
    "technicalArchive": {
      "type": "object",
      "description": "Internal or secondary preservation metadata. Do not render automatically on public pages.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "credit", "rightsStatus"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "$ref": "#/$defs/localizedText" },
        "caption": { "$ref": "#/$defs/localizedText" },
        "credit": { "type": "string" },
        "rightsStatus": { "enum": ["owned", "approved", "public-reference"] }
      }
    },
    "linkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "kind"],
      "properties": {
        "label": { "$ref": "#/$defs/localizedText" },
        "url": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["official", "video", "press", "archive", "related"] }
      }
    }
  }
}
